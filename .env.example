# Server-side only. Configure privately in hosting settings.
NANSEN_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set a hard limit on actual outbound requests. Zero/unset disables live refresh.
NANSEN_MAX_API_CALLS=0
